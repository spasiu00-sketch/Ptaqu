[node name="START_GAME" type="Node3D" unique_id=1430041279]

[node name="Intro" type="CanvasLayer" parent="." unique_id=2136756777]
script = ExtResource("14_u5pcf")
nazwa_postaci = "Bartek Sergafin"
podtytul = "elektronik, 24 lat"
tekst = "---
Była północ. Wiatr wył w kominach, a na grupie na Messengerze dawno już zgasły ostatnie duszki. Tylko Bartek Sergafin siedział w ciemnym pokoju, wpatrując się w ekran telefonu. Zadanie było proste, a zarazem idiotyczne – żeby zaliczyć rok u najgroźniejszego belfra w mieście, musiał wejść do Opuszczonego Zespołu Szkół im. Przepalonego ptaqa i wynieść stamtąd legendarny dziennik elektroniczny, w którym oceny same zmieniały się na jedynki.
Bartek nie był zwykłym uczniem. Na tę misję ubrał się w swój ulubiony stratosferyczny secik bojowy: stożkowy kapelusz ryżowy (chroniący przed mind-fuckiem i psychiką stalkerów) oraz koszulkę z napisem „24h Le Mans”, bo wiedział, że w tej szkole trzeba uciekać szybko, a czas reakcji musi być lepszy niż ping w lolu.
[Obrazek]
---
W jego głowie, zamiast zdrowego rozsądku i paniki, siedział niezwykle charyzmatyczny, lekko nadpobudliwy hiszpański wujek (lub po prostu losowy, śmieszny Hiszpan), który co chwilę krzyczał przez wyimaginowane radio: „¡Ándale, ándale, Bartek, uciekaj, bo torreador idzie!”.
---
Zamiast profesjonalnego sprzętu przetrwania, jego jedynym ekwipunkiem bojowym był legendarny zestaw taktyczny: plastikowa latarka na trzy duże baterie R20, kupiona na bazarku za piątkę, która mrugała w rytm hiszpańskiego techno, oraz – rzecz jasna – stożkowy kapelusz ryżowy i koszulka z wyścigu Le Mans, które dodawały mu +10 do aerodynamiki ucieczki."
czas_wejscia = 4.0
strony_obrazkowe = Array[Texture2D]([ExtResource("2_ihq08")])

